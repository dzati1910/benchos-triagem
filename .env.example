# PostgreSQL (Docker Compose / Prod & Dev)
POSTGRES_USER=benchos
POSTGRES_PASSWORD=benchos_dev_pass
POSTGRES_DB=benchos

# Container Names (para docker-compose.prod.yml e isolamento de smoke tests)
POSTGRES_CONTAINER_NAME=benchos-postgres-prod
APP_CONTAINER_NAME=benchos-app-prod

# Backend API & Prisma
# Nota: Em docker-compose.prod.yml, o DATABASE_URL é construído dinamicamente
# apontando para o serviço postgres na rede interna (postgres:5432).
DATABASE_URL="postgresql://benchos:benchos_dev_pass@localhost:5432/benchos?schema=public"
PORT=3001
JWT_SECRET="troque-esta-chave-secreta-com-pelo-menos-32-caracteres"
JWT_EXPIRES_IN="7d"

# Usuário ADMIN inicial criado pelo seed
SEED_ADMIN_NAME="Administrador BenchOS"
SEED_ADMIN_EMAIL="admin@benchos.local"
SEED_ADMIN_PASSWORD="Admin@123"
